NODE_ENV=development
PORT=3001
# Docker Compose only: set a private URL-safe value in ignored .env, matching DATABASE_URL.
POSTGRES_PASSWORD=replace-me
# Supplied Compose database uses host port 15432; native PostgreSQL/RDS commonly use 5432.
# Use explicit IPv4 loopback locally to avoid slow localhost connection fallback on Windows.
DATABASE_URL=postgresql://zenex:replace-me@127.0.0.1:15432/zenex?schema=public&connection_limit=10&pool_timeout=10
AWS_REGION=ap-south-1
# S3 is in Mumbai; AWS_REGION above remains the Cognito/SQS region.
S3_REGION=ap-south-1
S3_BUCKET=zenex-international-mrpob-files
COGNITO_USER_POOL_ID=ap-south-1_REPLACE_ME
COGNITO_CLIENT_ID=replace-me
# Optional for confidential app clients; keep server-side only.
COGNITO_CLIENT_SECRET=
IDEMPOTENCY_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_ORIGIN=http://localhost:3000
ENABLE_SWAGGER=true
SENTRY_DSN=
# SDK uses the default credential chain. Prefer AWS_PROFILE locally, task IAM role on ECS.
# Never put static credentials in the frontend or commit real .env files.
AWS_PROFILE=

# Registration decisions always persist notification events, even with the worker off.
# Enable in a separate worker task with NOTIFICATION_SQS_URL and DLQ configured.
NOTIFICATION_WORKER_ENABLED=false
NOTIFICATION_SQS_URL=
NOTIFICATION_SQS_DLQ_URL=
# mock records a simulation in PostgreSQL; it never sends a WhatsApp message.
WHATSAPP_PROVIDER=mock
WHATSAPP_LIVE_ENABLED=false
WHATSAPP_TEMPLATES_APPROVED=false
WHATSAPP_REJECTIONS_ENABLED=false
# Reserved configuration only; AtoZ transport remains blocked pending its API contract.
ATOZ_API_ENDPOINT=
ATOZ_API_CREDENTIAL=
ATOZ_SENDER_ID=
# Canonical approval template IDs/names supplied by the eventual provider.
WHATSAPP_TEMPLATE_CUSTOMER_REGISTRATION_APPROVED=
WHATSAPP_TEMPLATE_PATIENT_REGISTRATION_APPROVED=
WHATSAPP_TEMPLATE_COMPANY_ADMIN_APPROVED=
# Shared registration_rejected template: applicant name, type, reviewed reason.
WHATSAPP_TEMPLATE_REGISTRATION_REJECTED=
# Legacy configuration aliases remain supported.
WHATSAPP_TEMPLATE_REGISTRATION_CUSTOMER_APPROVED=
WHATSAPP_TEMPLATE_REGISTRATION_COMPANY_APPROVED=
WHATSAPP_TEMPLATE_REGISTRATION_PATIENT_APPROVED=
WHATSAPP_TEMPLATE_REGISTRATION_CUSTOMER_REJECTED=
WHATSAPP_TEMPLATE_REGISTRATION_COMPANY_REJECTED=
WHATSAPP_TEMPLATE_REGISTRATION_PATIENT_REJECTED=

# Administrative imports: optional limits; values may reduce the documented ceilings.
IMPORT_WORKBOOK_MAX_BYTES=41943040
IMPORT_DOCUMENT_MAX_BYTES=5242880
IMPORT_DOCUMENT_TOTAL_BYTES=26214400
IMPORT_CONCURRENT_REQUESTS=2

# Compressed supporting ZIP ceiling; expanded files remain capped at 25 MiB total.
IMPORT_ARCHIVE_MAX_BYTES=31457280
