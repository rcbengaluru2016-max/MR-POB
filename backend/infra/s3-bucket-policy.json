{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyInsecureTransport",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::zenex-international-mrpob-files", "arn:aws:s3:::zenex-international-mrpob-files/*"],
      "Condition": {"Bool": {"aws:SecureTransport": "false"}}
    }
  ]
}
