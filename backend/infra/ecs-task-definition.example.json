{
  "family": "zenex-registration-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/zenex-ecs-execution",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/zenex-registration-task",
  "containerDefinitions": [
    {
      "name": "backend",
      "image": "ACCOUNT_ID.dkr.ecr.ap-southeast-2.amazonaws.com/zenex-backend:IMMUTABLE_COMMIT_SHA",
      "essential": true,
      "portMappings": [{"containerPort": 3001, "protocol": "tcp"}],
      "readonlyRootFilesystem": true,
      "environment": [
        {"name": "NODE_ENV", "value": "production"},
        {"name": "PORT", "value": "3001"},
        {"name": "FRONTEND_ORIGIN", "value": "https://erp.example.com"},
        {"name": "AWS_REGION", "value": "ap-south-1"},
        {"name": "S3_REGION", "value": "ap-south-1"},
        {"name": "S3_BUCKET", "value": "zenex-international-mrpob-files"}
      ],
      "secrets": [
        {"name": "DATABASE_URL", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:zenex/backend:databaseUrl::"},
        {"name": "IDEMPOTENCY_SECRET", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:zenex/backend:idempotencySecret::"},
        {"name": "COGNITO_USER_POOL_ID", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:zenex/backend:userPoolId::"},
        {"name": "COGNITO_CLIENT_ID", "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:ACCOUNT_ID:secret:zenex/backend:clientId::"}
      ],
      "logConfiguration": {"logDriver": "awslogs", "options": {"awslogs-group": "/ecs/zenex-registration", "awslogs-region": "ap-southeast-2", "awslogs-stream-prefix": "backend"}},
      "healthCheck": {"command": ["CMD-SHELL", "node -e \"fetch('http://localhost:3001/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""], "interval": 30, "timeout": 5, "retries": 3, "startPeriod": 30}
    }
  ]
}
