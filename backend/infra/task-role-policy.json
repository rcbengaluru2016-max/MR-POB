{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistrationObjectsOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:GetObjectVersion", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": [
        "arn:aws:s3:::zenex-international-mrpob/registration/customer/*",
        "arn:aws:s3:::zenex-international-mrpob/registration/company/*",
        "arn:aws:s3:::zenex-international-mrpob/registration/patient/*"
      ]
    },
    {
      "Sid": "FindUncertainUploadVersions",
      "Effect": "Allow",
      "Action": ["s3:ListBucketVersions"],
      "Resource": "arn:aws:s3:::zenex-international-mrpob",
      "Condition": {"StringLike": {"s3:prefix": ["registration/customer/*", "registration/company/*", "registration/patient/*"]}}
    }
  ]
}
