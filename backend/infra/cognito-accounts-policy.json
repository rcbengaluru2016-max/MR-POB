{
  "Version": "2012-10-17",
  "Statement": [{
    "Sid": "ManageErpLoginCredentialsInExistingPool",
    "Effect": "Allow",
    "Action": [
      "cognito-idp:AdminGetUser", "cognito-idp:AdminCreateUser",
      "cognito-idp:AdminSetUserPassword", "cognito-idp:AdminEnableUser", "cognito-idp:AdminDisableUser"
    ],
    "Resource": "arn:aws:cognito-idp:ap-southeast-2:REPLACE_WITH_AWS_ACCOUNT_ID:userpool/REPLACE_WITH_EXISTING_POOL_ID"
  }]
}
