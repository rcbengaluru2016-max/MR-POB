{
  "name": "zenex-registration-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/notification-worker.js",
    "dev": "npm run build && node --watch dist/main.js",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "test": "jest --runInBand",
    "test:integration": "jest --config test/jest-integration.json --runInBand",
    "test:e2e": "playwright test",
    "check": "prisma validate && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.900.0",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/client-sqs": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@prisma/client": "^6.19.0",
    "@sentry/node": "^10.0.0",
    "aws-jwt-verify": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "pdf-lib": "^1.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@playwright/test": "^1.56.0",
    "@testcontainers/postgresql": "^11.7.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "express": {
      "body-parser": "2.4.0"
    },
    "dockerode": {
      "uuid": "11.1.1"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "testPathIgnorePatterns": [
      "/integration/",
      "/e2e/"
    ],
    "clearMocks": true
  }
}
