generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum RegistrationKind {
  customer
  company
  patient
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Role {
  ADMIN
  SUPER_ADMIN
  CUSTOMER
  COMPANY
  PATIENT
}

enum UserState {
  ACTIVE
  INACTIVE
}

model ErpUser {
  id String @id @default(uuid()) @db.Uuid
  cognitoSub String? @unique
  username String @unique
  email String? @unique @db.VarChar(254)
  displayName String
  role Role
  state UserState @default(INACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String? @db.Uuid
  lastLoginAt DateTime?
  deletedAt DateTime?
  tokensValidAfter DateTime?
  mfaEnrollmentRequired Boolean @default(false)
  createdBy ErpUser? @relation("CreatedAccounts", fields: [createdById], references: [id], onDelete: Restrict)
  createdAccounts ErpUser[] @relation("CreatedAccounts")
  ownedRegistrations Registration[] @relation("Owner")
  decisions Registration[] @relation("Decision")
  audits AuditEvent[]
  resetTokens AccountResetToken[]
  imports ImportJob[]
  @@index([role, createdAt, id])
  @@index([role, state, deletedAt, createdAt, id])
}

model AccountResetToken {
  id String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  tokenHash String @unique @db.VarChar(64)
  createdAt DateTime @default(now())
  expiresAt DateTime
  createdById String @db.Uuid
  usedAt DateTime?
  invalidatedAt DateTime?
  // A claimed token is never automatically released after an uncertain remote write.
  claimedAt DateTime?
  previousState UserState
  account ErpUser @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@index([accountId, expiresAt])
}

model AccountStepUp {
  id String @id @default(uuid()) @db.Uuid
  actorId String @db.Uuid
  binding String @db.VarChar(64)
  encryptedSession String
  username String
  challengeName String
  expiresAt DateTime
  verifiedAt DateTime?
  consumedAt DateTime?
  proofHash String? @unique @db.VarChar(64)
  attempts Int @default(0)
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}

model Registration {
  id String @id
  registrationSource String @default("Normal Registration") @db.VarChar(30)
  importedById String? @db.Uuid
  importedAt DateTime?
  importJobId String? @db.Uuid
  masterCode String? @unique
  // One-way credential verifier, never returned by registration APIs.
  passwordHash String?
  kind RegistrationKind
  status RegistrationStatus @default(PENDING)
  mobile String @db.VarChar(10)
  email String? @db.VarChar(254)
  termsAcceptedAt DateTime @default(now())
  termsVersion String @default("registration-v1")
  submittedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  decidedAt DateTime?
  decidedById String? @db.Uuid
  rejectionReason String?
  rejectionReasonCode String? @db.VarChar(50)
  rejectionExpiresAt DateTime?
  ownerId String? @db.Uuid
  idempotencyKey String? @unique
  requestHash String
  owner ErpUser? @relation("Owner", fields: [ownerId], references: [id])
  decidedBy ErpUser? @relation("Decision", fields: [decidedById], references: [id])
  customer CustomerRegistration?
  company CompanyRegistration?
  patient PatientRegistration?
  documents Document[]
  audits AuditEvent[]
  notifications RegistrationNotification[]
  @@index([importJobId])
  @@unique([kind, mobile])
  @@unique([kind, email])
  @@index([kind, status, submittedAt, id])
  @@index([rejectionExpiresAt])
}

model CustomerRegistration {
  registrationId String @id
  customerName String @db.VarChar(200)
  businessName String @db.VarChar(200)
  customerType String @db.VarChar(50)
  dlNumber1 String @db.VarChar(100)
  dlNumber2 String @db.VarChar(100)
  dlNumber3 String? @db.VarChar(100)
  fssaiNumber String? @db.VarChar(100)
  gstNumber String @unique @db.VarChar(100)
  creditDays String @db.VarChar(50)
  paymentMethod String @db.VarChar(50)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  address CustomerAddress?
}

model CustomerAddress {
  registrationId String @id
  addressLine1 String @db.VarChar(500)
  addressLine2 String? @db.VarChar(500)
  addressLine3 String? @db.VarChar(500)
  addressLine4 String? @db.VarChar(500)
  pinCode String @db.VarChar(6)
  customer CustomerRegistration @relation(fields: [registrationId], references: [registrationId], onDelete: Cascade)
}

model CompanyRegistration {
  registrationId String @id
  companyName String @db.VarChar(200)
  division String @db.VarChar(200)
  headquarter String @db.VarChar(200)
  adminFullName String @db.VarChar(200)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model PatientRegistration {
  registrationId String @id
  patientName String @db.VarChar(200)
  gender String? @db.VarChar(30)
  address String @db.VarChar(2000)
  paymentMethod String @db.VarChar(50)
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
}

model Document {
  id String @id @default(uuid()) @db.Uuid
  registrationId String
  slot String @db.VarChar(50)
  originalName String @db.VarChar(200)
  objectKey String @unique
  versionId String?
  contentType String @db.VarChar(100)
  size Int
  sha256 String @db.VarChar(64)
  createdAt DateTime @default(now())
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  @@unique([registrationId, slot])
}

model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  registrationId String?
  action String @db.VarChar(100)
  detail Json?
  createdAt DateTime @default(now())
  actor ErpUser? @relation(fields: [actorId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  @@index([registrationId, createdAt])
}

enum ImportStatus {
  PENDING_VALIDATION
  VALIDATING
  VALIDATION_FAILED
  READY
  IMPORTING
  COMPLETED
  FAILED
  PARTIALLY_COMPLETED
  CANCELLED
}

model ImportJob {
  id String @id @default(uuid()) @db.Uuid
  kind RegistrationKind
  importType String @db.VarChar(10)
  fileName String @db.VarChar(200)
  supportingFileName String? @db.VarChar(200)
  warnings String[] @default([])
  uploadedById String @db.Uuid
  uploadedBy ErpUser @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt DateTime @default(now())
  status ImportStatus @default(PENDING_VALIDATION)
  requestHash String @db.VarChar(64)
  idempotencyKey String? @unique @db.VarChar(128)
  totalRecords Int @default(0)
  validRecords Int @default(0)
  importedRecords Int @default(0)
  progress Int @default(0)
  errorSummary String?
  expiresAt DateTime
  confirmedAt DateTime?
  completedAt DateTime?
  deletedAt DateTime?
  records ImportRecord[]
  @@index([deletedAt, uploadedAt, id])
  @@index([status, expiresAt])
}

model ImportRecord {
  id String @id @default(uuid()) @db.Uuid
  jobId String @db.Uuid
  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Restrict)
  rowNumber Int
  registrationId String?
  masterCode String?
  data Json
  errors String[]
  duplicate Boolean @default(false)
  batchId String? @db.Uuid
  credentialHash String?
  documents Json
  @@unique([jobId, rowNumber])
}

model UploadBatch {
  id String @id @default(uuid()) @db.Uuid
  registrationId String @unique
  completedAt DateTime?
  cleanupStartedAt DateTime?
  cleanupAfter DateTime
  createdAt DateTime @default(now())
  objects UploadObject[]
  @@index([completedAt, cleanupAfter])
}

model UploadObject {
  id String @id @default(uuid()) @db.Uuid
  batchId String @db.Uuid
  objectKey String @unique
  versionId String?
  batch UploadBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
}

enum NotificationStatus {
  PENDING
  RETRY
  PROCESSING
  MOCKED
  ACCEPTED
  DELIVERED
  BLOCKED
  UNKNOWN
  FAILED
  EXPIRED
}

// This row is both the transactional outbox and the durable delivery ledger.
model RegistrationNotification {
  id String @id @default(uuid()) @db.Uuid
  registrationId String
  event RegistrationStatus
  kind RegistrationKind
  recipient String @db.VarChar(16)
  templateKey String @db.VarChar(100)
  templateId String?
  payload Json
  status NotificationStatus @default(PENDING)
  attempts Int @default(0)
  publishAttempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  enqueueAfter DateTime @default(now())
  leaseUntil DateTime?
  claimToken String? @db.Uuid
  providerMessageId String?
  lastError String? @db.VarChar(100)
  deadLetteredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Restrict)
  deliveries NotificationAttempt[]
  @@unique([registrationId, event])
  @@index([status, enqueueAfter, nextAttemptAt])
  @@index([status, leaseUntil])
}

model NotificationAttempt {
  id String @id @default(uuid()) @db.Uuid
  notificationId String @db.Uuid
  number Int
  outcome String @db.VarChar(30)
  errorCode String? @db.VarChar(100)
  startedAt DateTime @default(now())
  finishedAt DateTime?
  notification RegistrationNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, number])
}
