# Copy to .env.local for local development. Never commit real secrets.

NEXT_PUBLIC_APP_NAME="Zenex International"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
BACKEND_API_URL="http://localhost:3001"
FRONTEND_ORIGIN="http://localhost:3000"

# Used to sign session cookies. Generate a long random string in production.
SESSION_SECRET=""

# Password for the designated Super Admin account. Use a unique password of at least 16 characters.
# The account is provisioned on first server-side store initialization; never commit a real value.
SUPER_ADMIN_PASSWORD=""

# Customer account activation OTP delivery (Twilio). Leave blank only for development
# environments where the activation flow should report that SMS is unavailable.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""
